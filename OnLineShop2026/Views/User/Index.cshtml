@model List<OnLineShop2026.Models.User>
@{
    ViewData["Title"] = "Пользователи";
}

<h1>Список пользователей</h1>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Аватар</th>
            <th>Имя</th>
            <th>Фамилия</th>
            <th>Email</th>
            <th>Доп</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td><img src="@user.Avatar" width="50" height="50" style="border-radius: 50%;" /></td>
                <td>@user.Name</td>
                <td>@user.SurName</td>
                <td>@user.Email</td>
                <td>
                    <a href="/User/Details?id=@user.Id" class="btn btn-primary">Подробнее</a>
                </td>
            </tr>
        }
    </tbody>
</table>